<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Handover · CPAT Report</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: ui-sans-serif, system-ui, "Segoe UI", sans-serif; margin: 2.5rem auto;
         max-width: 960px; padding: 0 1rem; background: #0f1115; color: #e8eaed; }
  h1 { font-size: 1.6rem; margin-bottom: .2rem; }
  h2 { font-size: 1.1rem; margin-top: 2.2rem; border-bottom: 1px solid #2a2e37; padding-bottom: .3rem; }
  .sub { color: #9aa0a6; font-size: .85rem; }
  table { border-collapse: collapse; width: 100%; margin-top: .8rem; font-size: .9rem; }
  th, td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid #22262e; }
  th { color: #9aa0a6; font-weight: 600; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .headline { display: flex; gap: 2.5rem; margin-top: 1.4rem; flex-wrap: wrap; }
  .stat { min-width: 150px; }
  .stat .v { font-size: 1.5rem; font-weight: 700; }
  .stat .k { color: #9aa0a6; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
  .grade { font-size: .72rem; padding: .1rem .45rem; border-radius: 999px; border: 1px solid; }
  .grade.measured { color: #7ee787; border-color: #2ea043; }
  .grade.derived { color: #f0b429; border-color: #9e6a03; }
  .warn { color: #ff7b72; }
  .empty { color: #9aa0a6; font-style: italic; padding: 1rem 0; }
  footer { margin-top: 3rem; color: #6e7681; font-size: .75rem; }
</style>
</head>
<body>
<h1>Handover · CPAT Report</h1>
<div class="sub">Cost per accepted task — all-attempt cost over verified successes · generated {{ generated_at }}</div>

<div class="headline">
  <div class="stat"><div class="v">{{ overall.cpat }}</div><div class="k">CPAT (all models)</div></div>
  <div class="stat"><div class="v">{{ overall.ttat }}</div><div class="k">TTAT</div></div>
  <div class="stat"><div class="v">{{ overall.attempts }}</div><div class="k">Attempts / win</div></div>
  <div class="stat"><div class="v {% if unknown_high %}warn{% endif %}">{{ unknown_rate }}</div><div class="k">Unknown rate</div></div>
</div>

<h2>Per model</h2>
<table>
  <tr><th>Model</th><th class="num">Verified tasks</th><th>Success rate (Wilson 95%)</th>
      <th class="num">CPAT</th><th class="num">TTAT</th><th class="num">Attempts/win</th></tr>
  {% for r in model_rows %}
  <tr><td>{{ r.model }}</td><td class="num">{{ r.n_verified }}</td><td>{{ r.success }}</td>
      <td class="num">{{ r.cpat }}</td><td class="num">{{ r.ttat }}</td><td class="num">{{ r.attempts }}</td></tr>
  {% endfor %}
</table>

<h2>Waste breakdown</h2>
<table>
  <tr><th>Component</th><th class="num">Amount</th><th>Evidence</th><th class="num">Traces</th></tr>
  {% for w in waste_rows %}
  <tr><td>{{ w.name }}</td><td class="num">{{ w.amount }}</td>
      <td><span class="grade {{ w.grade }}">{{ w.grade }}</span></td><td class="num">{{ w.n }}</td></tr>
  {% endfor %}
  <tr><td><strong>Total waste</strong></td><td class="num"><strong>{{ waste_total }}</strong></td><td></td><td></td></tr>
</table>
{% if n_unpriced %}<div class="sub">{{ n_unpriced }} traces had no price entry and contribute $0 (counted, not guessed).</div>{% endif %}

<h2>Per cluster</h2>
<div class="empty">Task clusters arrive in P1 (taxonomy extraction). This table is intentionally empty.</div>

<footer>
  {{ n_tasks }} tasks total · {{ n_unknown }} unverified (excluded from every metric) ·
  metadata-only: no request or response content exists in this report's inputs.
</footer>
</body>
</html>
