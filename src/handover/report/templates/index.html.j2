<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ grade_name }}</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body { font-family: ui-sans-serif, system-ui, "Segoe UI", sans-serif; margin: 0;
         background: #0b0e14; color: #e8eaed; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 2rem 1rem 4rem; }
  h1 { font-size: 1.5rem; margin: 0; }
  h1 .b { color: #4f8ff7; }
  .sub { color: #8b93a1; font-size: .85rem; margin-top: .25rem; }
  .sliders { display: flex; gap: 2rem; flex-wrap: wrap; margin: 1.6rem 0 1.2rem;
             background: #131824; border: 1px solid #1f2736; border-radius: 12px; padding: 1rem 1.2rem; }
  .slider { flex: 1; min-width: 180px; }
  .slider label { display: flex; justify-content: space-between; font-size: .78rem;
                  color: #8b93a1; text-transform: uppercase; letter-spacing: .05em; }
  .slider label b { color: #e8eaed; font-variant-numeric: tabular-nums; }
  input[type=range] { width: 100%; accent-color: #4f8ff7; }
  .hint { color: #8b93a1; font-size: .75rem; margin-bottom: 1.4rem; }
  table { border-collapse: collapse; width: 100%; font-size: .9rem; }
  th { color: #8b93a1; font-weight: 600; font-size: .72rem; text-transform: uppercase;
       letter-spacing: .05em; text-align: left; padding: .55rem .7rem; border-bottom: 1px solid #1f2736; }
  th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }
  td { padding: .7rem .7rem; border-bottom: 1px solid #151b28; }
  .rank { color: #8b93a1; width: 2.2rem; }
  .mname { font-weight: 700; }
  .score { font-weight: 800; font-size: 1.05rem; }
  .good { color: #3fb950; } .mid { color: #d29922; } .low { color: #f85149; }
  .bar { background: #1f2736; border-radius: 999px; height: 6px; width: 160px; margin-top: .35rem; }
  .bar i { display: block; height: 6px; border-radius: 999px; background: #4f8ff7; }
  footer { margin-top: 3rem; color: #5b6472; font-size: .75rem; line-height: 1.6; }
</style>
</head>
<body>
<div class="wrap">
  <h1><span class="b">{{ brand }}</span> Grade — Model Index</h1>
  <div class="sub">Verified-task performance, per cluster, cost-share weighted · generated {{ generated_at }}</div>

  <div class="sliders">
    <div class="slider"><label>Quality <b id="wq-v">60%</b></label>
      <input type="range" id="wq" min="0" max="100" value="60"></div>
    <div class="slider"><label>Speed <b id="ws-v">20%</b></label>
      <input type="range" id="ws" min="0" max="100" value="20"></div>
    <div class="slider"><label>Value <b id="wv-v">20%</b></label>
      <input type="range" id="wv" min="0" max="100" value="20"></div>
  </div>
  <div class="hint">Drag to reprice the market by what YOU value — weights renormalize automatically.
    Scores are min-max normalized within each task cluster, never across clusters.</div>

  <table>
    <thead><tr><th class="rank">#</th><th>Model</th><th>Score</th><th class="num">Clusters scored</th></tr></thead>
    <tbody id="rows"></tbody>
  </table>

  <footer>
    Methodology: Score(w) = w_q·norm(quality) + w_s·norm(speed 1/TTAT, log) + w_v·norm(value 1/CPAT, log),
    per cluster; overall = cost-share-weighted mean. Time series are never edited retroactively.
    Weight telemetry note: this local page sends nothing anywhere.
  </footer>
</div>

<script>
  var DATA = {{ payload }};

  function currentWeights() {
    var raw = [wq.value, ws.value, wv.value].map(Number);
    var total = raw[0] + raw[1] + raw[2] || 1;
    return { q: raw[0] / total, s: raw[1] / total, v: raw[2] / total, raw: raw, total: total };
  }

  function recompute() {
    var w = currentWeights();
    document.getElementById("wq-v").textContent = Math.round(w.q * 100) + "%";
    document.getElementById("ws-v").textContent = Math.round(w.s * 100) + "%";
    document.getElementById("wv-v").textContent = Math.round(w.v * 100) + "%";

    var perModel = {};
    DATA.norms.forEach(function (n) {
      var score = 100 * (w.q * n.quality + w.s * n.speed + w.v * n.value);
      var share = DATA.cost_shares[n.cluster_id] || 0;
      var m = perModel[n.model_id] || (perModel[n.model_id] = { weighted: 0, share: 0, clusters: 0 });
      m.weighted += score * share;
      m.share += share;
      m.clusters += 1;
    });

    var entries = Object.keys(perModel).map(function (model) {
      var m = perModel[model];
      return { model: model, score: m.share ? m.weighted / m.share : null, clusters: m.clusters };
    }).sort(function (a, b) { return (b.score || -1) - (a.score || -1); });

    var body = document.getElementById("rows");
    body.innerHTML = "";
    entries.forEach(function (entry, i) {
      var cls = entry.score === null ? "low" : entry.score >= 80 ? "good" : entry.score >= 60 ? "mid" : "low";
      var medal = i === 0 ? "🥇" : i === 1 ? "🥈" : i === 2 ? "🥉" : (i + 1);
      var row = document.createElement("tr");
      row.innerHTML =
        '<td class="rank">' + medal + "</td>" +
        '<td><span class="mname">' + entry.model + "</span>" +
        '<div class="bar"><i style="width:' + Math.max(0, Math.round(entry.score || 0)) + '%"></i></div></td>' +
        '<td><span class="score ' + cls + '">' + (entry.score === null ? "—" : entry.score.toFixed(1)) + "</span></td>" +
        '<td class="num">' + entry.clusters + "</td>";
      body.appendChild(row);
    });
  }

  ["wq", "ws", "wv"].forEach(function (id) {
    document.getElementById(id).addEventListener("input", recompute);
  });
  recompute();
</script>
</body>
</html>
